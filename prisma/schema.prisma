//业绩记录表
model PerformanceRecord {
  id Int @id @default(autoincrement())

  /// 关联信息
  orderId Int
  dispatchId Int?
  settlementId Int?

  /// 归属对象
  ownerUserId Int
  ownerRoleType PerformanceOwnerRoleType

  /// 时间归属（用于日/月统计）
  statsDate DateTime @db.Date
  statsMonth String @db.VarChar(7) // 例如：2026-03

  /// 订单 / 项目分类（尽量存结果型维度，避免大量联表）
  billingMode BillingMode?
  orderType OrderType?
  projectId Int?
  bizLine String? @db.VarChar(50)

  /// 金额结果
  grossPerformanceAmount Decimal @db.Decimal(12, 2) // 抽成前业绩
  netIncomeAmount Decimal @db.Decimal(12, 2) // 抽成后收益
  negativeIncomeAmount Decimal @default(0) @db.Decimal(12, 2) // 负收益金额

  /// 贡献辅助
  contributionBaseAmount Decimal? @db.Decimal(12, 2)
  commissionRate Decimal? @db.Decimal(6, 4)

  /// 行为标记
  isAccepted Boolean @default(false)
  isArchived Boolean @default(false)
  isCompleted Boolean @default(false)
  isBombed Boolean @default(false)
  isComplained Boolean @default(false)
  isAfterSale Boolean @default(false)
  isCancelled Boolean @default(false)

  /// 投诉辅助金额（当前先预留）
  complaintOrderAmount Decimal @default(0) @db.Decimal(12, 2)
  complaintPenaltyAmount Decimal @default(0) @db.Decimal(12, 2)

  remark String? @db.VarChar(255)
  status PerformanceRecordStatus @default(EFFECTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, ownerRoleType, statsDate], map: "idx_perf_owner_date")
  @@index([ownerRoleType, statsDate], map: "idx_perf_role_date")
  @@index([orderId], map: "idx_perf_order")
  @@index([dispatchId], map: "idx_perf_dispatch")
  @@index([settlementId], map: "idx_perf_settlement")
  @@index([billingMode, statsDate], map: "idx_perf_billing_date")
  @@index([orderType, statsDate], map: "idx_perf_ordertype_date")
  @@index([projectId, statsDate], map: "idx_perf_project_date")
  @@index([bizLine, statsDate], map: "idx_perf_bizline_date")
  @@index([isBombed, statsDate], map: "idx_perf_bombed_date")
  @@index([isComplained, statsDate], map: "idx_perf_complained_date")
  @@index([isAfterSale, statsDate], map: "idx_perf_aftersale_date")
  @@index([isCancelled, statsDate], map: "idx_perf_cancelled_date")
  @@index([statsMonth], map: "idx_perf_stats_month")
}

//订单财务记录表
model OrderFinanceRecord {
  id Int @id @default(autoincrement())

  /// 关联信息
  orderId Int @unique
  customerUserId Int?

  /// 时间归属
  statsDate DateTime @db.Date
  statsMonth String @db.VarChar(7) // 例如：2026-03

  /// 订单 / 项目分类
  billingMode BillingMode?
  orderType OrderType?
  projectId Int?
  bizLine String? @db.VarChar(50)

  /// 收入口径
  receivableAmount Decimal @default(0) @db.Decimal(12, 2) // 应收
  paidAmount Decimal @default(0) @db.Decimal(12, 2) // 实收
  discountAmount Decimal @default(0) @db.Decimal(12, 2) // 总优惠
  couponDiscountAmount Decimal @default(0) @db.Decimal(12, 2) // 优惠券优惠
  otherDiscountAmount Decimal @default(0) @db.Decimal(12, 2) // 其他优惠

  /// 支出口径
  playerCostAmount Decimal @default(0) @db.Decimal(12, 2)
  csCostAmount Decimal @default(0) @db.Decimal(12, 2)
  operationCostAmount Decimal @default(0) @db.Decimal(12, 2)
  channelCostAmount Decimal @default(0) @db.Decimal(12, 2)
  complaintPenaltyAmount Decimal @default(0) @db.Decimal(12, 2)
  afterSaleCostAmount Decimal @default(0) @db.Decimal(12, 2)

  /// 结果口径
  grossProfitAmount Decimal @default(0) @db.Decimal(12, 2)

  /// 辅助标记（当前先预留）
  isComplained Boolean @default(false)
  isAfterSale Boolean @default(false)
  isCancelled Boolean @default(false)

  remark String? @db.VarChar(255)
  status FinanceRecordStatus @default(EFFECTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statsDate], map: "idx_fin_stats_date")
  @@index([statsMonth], map: "idx_fin_stats_month")
  @@index([customerUserId, statsDate], map: "idx_fin_customer_date")
  @@index([billingMode, statsDate], map: "idx_fin_billing_date")
  @@index([orderType, statsDate], map: "idx_fin_ordertype_date")
  @@index([projectId, statsDate], map: "idx_fin_project_date")
  @@index([bizLine, statsDate], map: "idx_fin_bizline_date")
  @@index([isComplained, statsDate], map: "idx_fin_complained_date")
  @@index([isAfterSale, statsDate], map: "idx_fin_aftersale_date")
  @@index([isCancelled, statsDate], map: "idx_fin_cancelled_date")
}

model PenaltyRule {
  id          Int                 @id @default(autoincrement())
  code        String              @unique @db.VarChar(32)
  name        String              @db.VarChar(120)
  category    PenaltyRuleCategory
  amount      Decimal             @db.Decimal(10, 2)
  description String?             @db.VarChar(255)
  enabled     Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdBy   Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  creator     User?               @relation("PenaltyRuleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  ticketDetails PenaltyTicketDetail[]

  @@index([enabled, sortOrder], map: "idx_penalty_rule_enabled_sort")
  @@index([category, enabled], map: "idx_penalty_rule_category")
  @@map("penalty_rules")
}

model PenaltyTicket {
  id               Int                @id @default(autoincrement())
  ticketNo         String             @unique @db.VarChar(32)
  userId           Int
  creatorId        Int?
  appealReviewerId Int?
  status           PenaltyTicketStatus @default(PENDING_CONFIRM)
  appealStatus     PenaltyAppealStatus @default(NONE)
  ruleAmount       Decimal            @db.Decimal(10, 2)
  finalAmount      Decimal            @db.Decimal(10, 2)
  deductedAmount   Decimal            @default(0.00) @db.Decimal(10, 2)
  deductedAt       DateTime?
  deductWalletTxId Int?
  reason           String?            @db.VarChar(255)
  sameCategoryStats Json?
  confirmAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation("PenaltyTicketUser", fields: [userId], references: [id], onDelete: Cascade)
  creator          User?              @relation("PenaltyTicketCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  appealReviewer   User?              @relation("PenaltyTicketReviewer", fields: [appealReviewerId], references: [id], onDelete: SetNull)
  details          PenaltyTicketDetail[]
  appeals          PenaltyAppeal[]
  fundFlows        PenaltyFundFlow[]

  @@index([userId, status, createdAt], map: "idx_penalty_ticket_user_status")
  @@index([status, createdAt], map: "idx_penalty_ticket_status")
  @@index([appealStatus, createdAt], map: "idx_penalty_ticket_appeal")
  @@index([creatorId], map: "idx_penalty_ticket_creator")
  @@map("penalty_tickets")
}

model PenaltyTicketDetail {
  id                   Int               @id @default(autoincrement())
  ticketId             Int
  ruleId               Int?
  ruleCodeSnapshot     String?           @db.VarChar(32)
  ruleNameSnapshot     String            @db.VarChar(120)
  ruleCategorySnapshot PenaltyRuleCategory
  amount               Decimal           @db.Decimal(10, 2)
  descriptionSnapshot  String?           @db.VarChar(255)
  createdAt            DateTime          @default(now())
  ticket               PenaltyTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rule                 PenaltyRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([ticketId], map: "idx_penalty_ticket_detail_ticket")
  @@index([ruleCategorySnapshot], map: "idx_penalty_ticket_detail_category")
  @@map("penalty_ticket_details")
}

model PenaltyAppeal {
  id           Int                @id @default(autoincrement())
  ticketId     Int                @unique
  userId       Int
  content      String             @db.Text
  status       PenaltyAppealStatus @default(PENDING)
  reviewedBy   Int?
  reviewedAt   DateTime?
  reviewRemark String?            @db.VarChar(255)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ticket       PenaltyTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user         User               @relation("PenaltyAppealUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?              @relation("PenaltyAppealReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_penalty_appeal_user")
  @@index([status, createdAt], map: "idx_penalty_appeal_status")
  @@map("penalty_appeals")
}

model PenaltyFundPool {
  id        Int               @id
  totalIn   Decimal           @default(0.00) @db.Decimal(12, 2)
  totalOut  Decimal           @default(0.00) @db.Decimal(12, 2)
  balance   Decimal           @default(0.00) @db.Decimal(12, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  flows     PenaltyFundFlow[]

  @@map("penalty_fund_pools")
}

model PenaltyFundFlow {
  id            Int                @id @default(autoincrement())
  poolId         Int                @default(1)
  ticketId       Int?
  userId         Int?
  direction      PenaltyFundDirection
  bizType        PenaltyFundBizType
  amount         Decimal            @db.Decimal(10, 2)
  beforeBalance  Decimal            @db.Decimal(12, 2)
  afterBalance   Decimal            @db.Decimal(12, 2)
  walletTxId     Int?
  operatorId     Int?
  remark         String?            @db.VarChar(255)
  createdAt      DateTime           @default(now())
  pool           PenaltyFundPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  ticket         PenaltyTicket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([ticketId, bizType], map: "uniq_penalty_flow_ticket_biz")
  @@index([createdAt], map: "idx_penalty_fund_flow_created")
  @@index([userId, createdAt], map: "idx_penalty_fund_flow_user")
  @@index([bizType, createdAt], map: "idx_penalty_fund_flow_biz")
  @@map("penalty_fund_flows")
}
