generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GameProject {
  id          Int           @id @default(autoincrement())
  name        String
  price       Float
  type        OrderType
  gameType    String?       @db.VarChar(64)
  projectType String?       @db.VarChar(64)
  category    String?       @db.VarChar(64)
  richContent String?       @db.LongText
  /// 计费模式：小时单 / 保底单/ 玩法单（你已落地）
  billingMode BillingMode   @default(GUARANTEED)
  baseAmount  Float?
  clubRate    Float?
  coverImage  String?
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orders      Order[]
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id        Int            @id @default(autoincrement())
  key       String         @unique
  name      String
  module    String
  type      PermissionType
  parentId  Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parent    Permission?    @relation("PermissionTree", fields: [parentId], references: [id])
  children  Permission[]   @relation("PermissionTree")
  roles     Role[]         @relation("PermissionToRole")

  @@index([parentId], map: "Permission_parentId_fkey")
}

model User {
  id                       Int                        @id @default(autoincrement())
  phone                    String                     @unique
  password                 String
  name                     String?
  email                    String?
  userType                 UserType                   @default(REGISTERED_USER)
  status                   UserStatus                 @default(ACTIVE)
  realName                 String?
  idCard                   String?
  avatar                   String?
  album                    Json?
  rating                   Int?
  level                    Int                        @default(1)
  balance                  Float                      @default(0)
  needResetPwd             Boolean                    @default(false)
  lastLoginAt              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  roleId                   Int?
  /// 陪玩接单状态（仅对 userType=STAFF/PLAYER 生效，v0.1.1 先不强约束）
  workStatus               PlayerWorkStatus           @default(IDLE)
  /// 提现收款二维码（对象存储 key）
  withdrawQrCodeKey        String?                    @db.VarChar(255)
  /// 上传时间（用于审计 / 防重复）
  withdrawQrCodeUploadedAt DateTime?
  canWithdraw              Boolean                    @default(true)
  depositLimit             Decimal                    @default(2000.00) @db.Decimal(10, 2)
  workMode                 StaffWorkMode              @default(ONLINE)
  offlineJoinedAt          DateTime?
  dispatchedOrders         Order[]                    @relation("OrderDispatcher")
  offlineFeeBills          OfflineFeeBill[]
  offlineFeePayments       OfflineFeeBillPayment[]
  announcementsCreated     SystemAnnouncement[]      @relation("AnnouncementCreator")
  announcementReads        SystemAnnouncementRead[]
  notifications            UserNotification[]
  csDutySchedules          CsDutySchedule[]
  csDutyLeaves             CsDutyLeave[]            @relation("CsDutyLeaveUser")
  csDutySubstituteLeaves   CsDutyLeave[]            @relation("CsDutyLeaveSubstitute")
  csDutyLeaveCreated       CsDutyLeave[]            @relation("CsDutyLeaveCreator")
  orderParticipants        OrderParticipant[]
  orderSettlements         OrderSettlement[]
  recharges                Recharge[]
  createdBatches           SettlementBatch[]          @relation("BatchCreator")
  depositTransactions      WalletDepositTransaction[]
  userLogs                 UserLog[]
  staffRating              StaffRating?               @relation(fields: [rating], references: [id])
  Role                     Role?                      @relation(fields: [roleId], references: [id])
  walletAccount            WalletAccount?
  walletHolds              WalletHold[]
  walletTransactions       WalletTransaction[]
  walletWithdrawalRequests WalletWithdrawalRequest[]
  createdPenaltyRules      PenaltyRule[]             @relation("PenaltyRuleCreator")
  penaltyTickets           PenaltyTicket[]           @relation("PenaltyTicketUser")
  createdPenaltyTickets    PenaltyTicket[]           @relation("PenaltyTicketCreator")
  reviewedPenaltyTickets   PenaltyTicket[]           @relation("PenaltyTicketReviewer")
  penaltyAppeals           PenaltyAppeal[]           @relation("PenaltyAppealUser")
  reviewedPenaltyAppeals   PenaltyAppeal[]           @relation("PenaltyAppealReviewer")
  penaltyFundFlows         PenaltyFundFlow[]
  userCoupons              UserCoupon[]
  chestRedeemedCodes       ChestRedeemCode[] @relation("ChestRedeemByUser")
  chestAccount             ChestUserAccount?
  chestOpenRecords         ChestOpenRecord[]

  @@index([workStatus])
  @@index([workMode, offlineJoinedAt])
  @@index([rating], map: "users_rating_fkey")
  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model ChestActivityConfig {
  id              Int      @id @default(autoincrement())
  activityKey     String   @unique @db.VarChar(64)
  title           String   @db.VarChar(120)
  enabled         Boolean  @default(false)
  defaultKeyCount Int      @default(1)
  launchAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rewardItems     ChestRewardItem[]

  @@map("chest_activity_configs")
}

model ChestRewardItem {
  id           Int      @id @default(autoincrement())
  activityKey  String   @db.VarChar(64)
  name         String   @db.VarChar(120)
  type         String   @db.VarChar(32)
  quantity     Int      @default(1)
  weight       Int      @default(1)
  stock        Int?
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(100)
  minDrawCount Int      @default(0)
  blockBeforeDays Int?
  rampEveryDays Int?
  rampStep Int?
  rampMaxExtra Int?
  dynamicMode  String?  @db.VarChar(64)
  publicRuleText String? @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activity     ChestActivityConfig @relation(fields: [activityKey], references: [activityKey], onDelete: Cascade)

  @@index([activityKey, enabled], map: "idx_chest_reward_item_activity_enabled")
  @@index([activityKey, sortOrder], map: "idx_chest_reward_item_activity_sort")
  @@map("chest_reward_items")
}

model ChestRedeemCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(64)
  keyCount     Int       @default(1)
  redeemedCount Int      @default(0)
  active       Boolean   @default(true)
  expireAt     DateTime?
  createdBy    Int?
  redeemedBy   Int?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  redeemedUser User?     @relation("ChestRedeemByUser", fields: [redeemedBy], references: [id], onDelete: SetNull)
  openRecords  ChestOpenRecord[]
  lastRedeemByAccounts ChestUserAccount[] @relation("ChestAccountLastRedeemCode")

  @@index([active, expireAt], map: "idx_chest_redeem_code_active_expire")
  @@index([redeemedBy], map: "idx_chest_redeem_code_redeemed_by")
  @@map("chest_redeem_codes")
}

model ChestUserAccount {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  keyCount  Int      @default(0)
  lastRedeemCodeId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastRedeemCode ChestRedeemCode? @relation("ChestAccountLastRedeemCode", fields: [lastRedeemCodeId], references: [id], onDelete: SetNull)

  @@map("chest_user_accounts")
}

model ChestOpenRecord {
  id         Int      @id @default(autoincrement())
  userId     Int
  costKeys   Int      @default(1)
  redeemCodeId Int?
  redeemCode   String?  @db.VarChar(64)
  verifiedAt DateTime?
  verifiedBy Int?
  verifyRemark String? @db.VarChar(255)
  rewardJson Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemCodeRef ChestRedeemCode? @relation(fields: [redeemCodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_chest_open_record_user_time")
  @@index([redeemCodeId], map: "idx_chest_open_record_redeem_code")
  @@map("chest_open_records")
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     String   @db.Text
  valueType ConfigValueType @default(STRING)
  remark    String?  @db.VarChar(255)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("system_configs")
}

model CouponTemplate {
  id                Int                  @id @default(autoincrement())
  name              String               @db.VarChar(120)
  type              CouponTemplateType
  discountValue     Decimal?             @db.Decimal(10, 2)
  thresholdAmount   Decimal?             @db.Decimal(10, 2)
  maxDiscountAmount Decimal?             @db.Decimal(10, 2)
  applicableScope   CouponScope          @default(ALL)
  /// 当 applicableScope=PROJECT 时，存项目ID数组
  applicableProjectIds Json?
  status            CouponTemplateStatus @default(DRAFT)
  startAt           DateTime?
  endAt             DateTime?
  totalLimit        Int?
  perUserLimit      Int?
  issuedCount       Int                  @default(0)
  usedCount         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  userCoupons       UserCoupon[]

  @@index([status, startAt, endAt], map: "idx_coupon_template_status_time")
  @@index([applicableScope], map: "idx_coupon_template_scope")
  @@map("coupon_templates")
}

model UserCoupon {
  id         Int             @id @default(autoincrement())
  userId     Int
  templateId Int
  status     UserCouponStatus @default(UNUSED)
  receivedAt DateTime        @default(now())
  usedAt     DateTime?
  expiresAt  DateTime?
  orderId    Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   CouponTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order      Order?          @relation("OrderAppliedUserCoupon", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt], map: "idx_user_coupon_user_status_expire")
  @@index([templateId, status], map: "idx_user_coupon_template_status")
  @@index([orderId], map: "idx_user_coupon_order")
  @@unique([orderId], map: "uniq_user_coupon_order")
  @@map("user_coupons")
}

model SystemAnnouncement {
  id          Int                      @id @default(autoincrement())
  title       String                   @db.VarChar(120)
  content     String                   @db.Text
  audience    AnnouncementAudience     @default(ALL)
  forceRead   Boolean                  @default(false)
  enabled     Boolean                  @default(true)
  publishAt   DateTime?
  expireAt    DateTime?
  notifiedAt  DateTime?
  createdBy   Int?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  creator     User?                    @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  reads       SystemAnnouncementRead[]

  @@index([enabled, publishAt, expireAt], map: "idx_announcement_publish")
  @@index([forceRead], map: "idx_announcement_force_read")
  @@map("system_announcements")
}

model SystemAnnouncementRead {
  id             Int                @id @default(autoincrement())
  announcementId Int
  userId         Int
  readAt         DateTime           @default(now())
  announcement   SystemAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId], map: "uniq_announcement_read_user")
  @@index([userId, readAt], map: "idx_announcement_read_user")
  @@map("system_announcement_reads")
}

model UserNotification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String           @db.VarChar(120)
  content   String           @db.Text
  payload   Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt], map: "idx_notification_user_read")
  @@index([type, createdAt], map: "idx_notification_type")
  @@map("user_notifications")
}

model CsDutySchedule {
  id          Int      @id @default(autoincrement())
  userId      Int
  weekday     Int
  weekdaysMask Int     @default(0)
  startMinute Int
  endMinute   Int
  enabled     Boolean  @default(true)
  remark      String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([weekday, enabled, startMinute, endMinute], map: "idx_cs_duty_shift")
  @@index([weekdaysMask, enabled], map: "idx_cs_duty_mask")
  @@index([userId, enabled], map: "idx_cs_duty_user")
  @@map("cs_duty_schedules")
}

model CsDutyLeave {
  id               Int      @id @default(autoincrement())
  userId           Int
  substituteUserId Int
  startAt          DateTime
  endAt            DateTime
  reason           String?  @db.VarChar(255)
  enabled          Boolean  @default(true)
  createdBy        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation("CsDutyLeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  substituteUser   User     @relation("CsDutyLeaveSubstitute", fields: [substituteUserId], references: [id], onDelete: Cascade)
  creator          User?    @relation("CsDutyLeaveCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([userId, enabled, startAt, endAt], map: "idx_cs_duty_leave_user_time")
  @@index([substituteUserId, enabled, startAt, endAt], map: "idx_cs_duty_leave_sub_time")
  @@index([enabled, startAt, endAt], map: "idx_cs_duty_leave_time")
  @@map("cs_duty_leaves")
}

model OfflineFeeBill {
  id                    Int                  @id @default(autoincrement())
  userId                Int
  billMonth             String               @db.VarChar(7)
  periodStart           DateTime             @db.Date
  periodEnd             DateTime             @db.Date
  performanceBaseAmount Decimal              @default(0.00) @db.Decimal(12, 2)
  rate                  Decimal              @default(0.10) @db.Decimal(6, 4)
  minAmount             Decimal              @default(0.00) @db.Decimal(12, 2)
  capAmount             Decimal              @default(0.00) @db.Decimal(12, 2)
  shouldPayAmount       Decimal              @default(0.00) @db.Decimal(12, 2)
  paidAmount            Decimal              @default(0.00) @db.Decimal(12, 2)
  remainingAmount       Decimal              @default(0.00) @db.Decimal(12, 2)
  status                OfflineFeeBillStatus @default(UNPAID)
  enforceFullPayment    Boolean              @default(false)
  lastRemindAt          DateTime?
  generatedAt           DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments              OfflineFeeBillPayment[]

  @@unique([userId, billMonth], map: "uniq_offline_fee_bill_user_month")
  @@index([billMonth, status], map: "idx_offline_fee_bill_month_status")
  @@index([status], map: "idx_offline_fee_bill_status")
  @@index([enforceFullPayment], map: "idx_offline_fee_bill_enforce")
  @@map("offline_fee_bills")
}

model OfflineFeeBillPayment {
  id                  Int                     @id @default(autoincrement())
  billId              Int
  userId              Int
  amount              Decimal                 @db.Decimal(12, 2)
  source              OfflineFeePaymentSource @default(WITHDRAWAL)
  withdrawalRequestId Int?
  operatorId          Int?
  remark              String?                 @db.VarChar(255)
  createdAt           DateTime                @default(now())
  bill                OfflineFeeBill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([billId, createdAt], map: "idx_offline_fee_bill_payments_bill")
  @@index([userId, createdAt], map: "idx_offline_fee_bill_payments_user")
  @@map("offline_fee_bill_payments")
}

/// 员工评级表
model StaffRating {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  rules       String
  scope       RatingScope
  status      RatingStatus @default(ACTIVE)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rate        Float
  users       User[]

  @@map("staff_ratings")
}

model Recharge {
  id        Int            @id @default(autoincrement())
  amount    Float
  userId    Int
  status    RechargeStatus @default(COMPLETED)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Recharge_userId_fkey")
}

model UserLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  targetType String
  targetId   Int?
  oldData    Json?
  newData    Json?
  remark     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_logs_userId_fkey")
  @@index([targetType, targetId], map: "user_logs_target")
  @@index([action], map: "user_logs_action")
  @@index([createdAt], map: "user_logs_createdAt")
  @@map("user_logs")
}

model Order {
  id                  Int               @id @default(autoincrement())
  /// 自动单号：建议 YYYYMMDD-0001（由代码生成，不靠 DB 自增）
  autoSerial          String            @unique
  /// 金额：手工录入（已确认 Q1=A）
  receivableAmount    Float
  paidAmount          Float
  /// 时间字段：
  orderTime           DateTime?
  paymentTime         DateTime?
  openedAt            DateTime          @default(now())
  /// 保底数额（单位：万）
  /// 仅保底/护航类项目使用；小时单可为空
  baseAmountWan       Float?
  /// 小时单“总小时”不再需要手填：
  /// 因为你要求用 接单时间 -> 存/结单时间 自动计算 billableHours
  /// 所以小时单的小时数最终落在 OrderDispatch.billableHours 上
  orderQuantity       Int               @default(1)
  /// 关联项目：仍用 GameProject（必选）
  projectId           Int
  /// 项目快照：记录当时项目配置（项目可能随时调整）
  /// 建议存：name/type/billingMode/baseAmount/clubRate/price 等
  projectSnapshot     Json
  /// 客户游戏 ID / 昵称：用于查询消费记录
  customerGameId      String?
  /// 派单客服：默认录单人
  dispatcherId        Int
  /// 回访登记：文本 + 状态
  revisitDetail       String?
  revisitStatus       RevisitStatus     @default(NOT_REVISITED)
  /// 分佣比例（可调）
  csRate              Float?
  inviteRate          Float?
  inviter             String?
  /// 俱乐部抽成比例（订单级固定抽成）
  customClubRate      Float?
  clubRate            Float?
  /// 结算汇总（可选，结单自动结算后写入，用于对账与校验）
  clubEarnings        Float?
  totalPlayerEarnings Float?
  /// 订单状态（用于筛选）
  status              OrderStatus       @default(WAIT_ASSIGN)
  /// 当前派单批次（为了快速查“这一轮派单/状态”）
  currentDispatchId   Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  /// 是否赠送单：赠送单不收款，但仍正常结算/分红；
  /// ⚠️ 日账单/营收统计需排除 isGifted=true 的订单
  isGifted            Boolean           @default(false)
  /// 赠送金额（用于统计活动成本/赠送成本）
  /// - 前端不传
  /// - 后端创建订单时：isGifted=true => giftedAmount = paidAmount（或订单价值口径）
  giftedAmount        Decimal?          @db.Decimal(10, 2)
  /// 是否已确认收款（人工确认）
  /// - 先打后付场景：结单后可能仍未收款
  /// - 确认收款接�����会同时写入 paymentTime=now() 与 paidAmount（允许修正）
  isPaid              Boolean           @default(false)
  /// 订单优惠汇总（统一优惠口径）
  /// - originalAmount：优惠前基准金额（通常=应收）
  /// - discountAmount：总优惠（可由多来源叠加）
  /// - finalPayableAmount：最终应付（优惠后）
  originalAmount        Decimal           @default(0) @db.Decimal(10, 2)
  discountAmount        Decimal           @default(0) @db.Decimal(10, 2)
  couponDiscountAmount  Decimal           @default(0) @db.Decimal(10, 2)
  activityDiscountAmount Decimal          @default(0) @db.Decimal(10, 2)
  giftDiscountAmount    Decimal           @default(0) @db.Decimal(10, 2)
  manualAdjustAmount    Decimal           @default(0) @db.Decimal(10, 2)
  finalPayableAmount    Decimal           @default(0) @db.Decimal(10, 2)
  marketingCostAmount   Decimal           @default(0) @db.Decimal(10, 2)
  /// 优惠类型：NONE / COUPON / ACTIVITY / GIFT / MANUAL / MIXED
  discountType          String?           @db.VarChar(20)
  appliedUserCoupon     UserCoupon?       @relation("OrderAppliedUserCoupon")
  currentDispatch     OrderDispatch?    @relation("OrderCurrentDispatch", fields: [currentDispatchId], references: [id])
  dispatcher          User              @relation("OrderDispatcher", fields: [dispatcherId], references: [id])
  project             GameProject       @relation(fields: [projectId], references: [id])
  dispatches          OrderDispatch[]   @relation("OrderDispatches")
  settlements         OrderSettlement[]
  discountDetails     OrderDiscount[]

  @@index([projectId])
  @@index([dispatcherId])
  @@index([status])
  @@index([customerGameId])
  @@index([currentDispatchId], map: "Order_currentDispatchId_fkey")
}

model OrderDiscount {
  id          Int      @id @default(autoincrement())
  orderId     Int
  /// 优惠来源：COUPON / GIFT / ACTIVITY / MANUAL
  sourceType  String   @db.VarChar(20)
  /// 来源主键：优惠券ID/活动ID/操作人ID（可空）
  sourceId    Int?
  /// 规则类型：CASH / DISCOUNT / FULL_REDUCTION / GIFT / MANUAL
  ruleType    String   @db.VarChar(30)
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_discounts_order_id")
  @@index([sourceType, createdAt], map: "idx_order_discounts_source_type")
  @@map("order_discounts")
}

model OrderDispatch {
  id                 Int                  @id @default(autoincrement())
  /// 属于哪个订单
  orderId            Int
  /// 第几轮派单（从 1 开始递增）
  /// 规则：只有上一轮 ARCHIVED 才允许创建下一轮
  round              Int
  /// 本轮状态：待派 -> 待接 -> 已接 -> 存单/结单
  status             DispatchStatus       @default(WAIT_ASSIGN)
  /// 时间：
  /// assignedAt：派单时间（客服执行派单时写入）
  /// acceptedAllAt：全员接单完成时间（当本轮所有 participant.acceptedAt 非空时写入）
  /// archivedAt：存单时间（打手点击存单写入）
  /// completedAt：结单时间（打手点击结单写入）
  assignedAt         DateTime?
  acceptedAllAt      DateTime?
  archivedAt         DateTime?
  completedAt        DateTime?
  /// 小时单：中途扣除时间（整单统一扣除）
  /// deductMinutes：枚举选项，用于 UI 固定下拉
  /// deductMinutesValue：冗余数值，方便后端计算/前端展示（10/20/.../60）
  deductMinutes      DeductMinutesOption?
  deductMinutesValue Int?
  /// 小时单：计费结果（由系统计算并落库）
  /// billableMinutes：扣除后有效分钟
  /// billableHours：计费小时（整数小时 + 分钟折算 0/0.5/1）
  billableMinutes    Int?
  billableHours      Float?
  /// 本轮备注：可存 “换号/异常/说明”
  remark             String?
  currentForOrders   Order[]              @relation("OrderCurrentDispatch")
  order              Order                @relation("OrderDispatches", fields: [orderId], references: [id], onDelete: Cascade)
  participants       OrderParticipant[]
  settlements        OrderSettlement[]

  @@unique([orderId, round])
  @@index([orderId])
  @@index([status])
}

model OrderParticipant {
  id                 Int           @id @default(autoincrement())
  /// 属于哪一轮派单
  dispatchId         Int
  /// 陪玩/打手（User）
  userId             Int
  /// 接单时间：陪玩确认接单后写入
  /// 规则：本轮“已接单”必须所有参与者 acceptedAt 都有值
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectReason       String?
  /// 贡献金额（可选）
  /// v0.1：结单默认均分；存单按进度比例算（保底/小时），贡献字段先留作未来扩展
  contributionAmount Float?        @default(0)
  /// 保底单：已打保底（单位：万）
  /// 允许负数：炸单（前端用“炸单额外加保底”选择转成负数）
  progressBaseWan    Float?
  /// 是否有效：存单再派可能替换陪玩（历史记录保留，但不参与后续）
  isActive           Boolean       @default(true)
  dispatch           OrderDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id])

  @@unique([dispatchId, userId])
  @@index([dispatchId])
  @@index([userId])
}

model OrderSettlement {
  id                 Int           @id @default(autoincrement())
  /// 属于哪个订单
  orderId            Int
  /// 哪一轮派单产生的结算（结单时落库）
  dispatchId         Int
  /// 哪个陪玩/打手
  userId             Int
  /// 结算类型：
  /// - EXPERIENCE：体验/福袋（每 3 天批次结算）
  /// - REGULAR：正价（按月批次结算）
  /// v0.1 先用 String，后期可改 enum（避免迁移频繁）
  settlementType     String
  /// 计算结果（结单时自动生成）
  calculatedEarnings Decimal?      @db.Decimal(10, 1)
  /// 人工调整：客服主管/财务可对“单个陪玩-单个订单”调整收益（你明确要求）
  /// finalEarnings = calculatedEarnings + manualAdjustment
  manualAdjustment   Decimal?      @db.Decimal(10, 1)
  finalEarnings      Decimal?      @db.Decimal(10, 1)
  /// 拆分记录（用于对账展示，可选）
  clubEarnings       Decimal?      @db.Decimal(10, 1)
  csEarnings         Float?
  inviteEarnings     Float?
  /// 打款状态：对账无误后由财务批量标记
  paymentStatus      PaymentStatus @default(UNPAID)
  paidAt             DateTime?
  /// 审计：谁调的、什么时候调、为什么调
  settledAt          DateTime      @default(now())
  adjustedBy         Int?
  adjustedAt         DateTime?
  adjustRemark       String?
  /// ✅ 本次结算批次号（一次结单/存单会生成 1 个批次号）
  /// - 用途1：追溯/审计（将来查“这次结算跑了哪些流水”）
  /// - 用途2：给外部系统/对账/异步任务（比如微信打款）做关联
  /// - 注意：真正的“防重复”靠下面的 uniq 约束；batchId 是增强追踪能力
  settlementBatchId  String        @db.VarChar(36)
  dispatch           OrderDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id])

  @@unique([dispatchId, userId, settlementType], map: "uniq_settlement_dispatch_user_type")
  @@index([orderId])
  @@index([dispatchId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([settlementBatchId])
}

model SettlementBatch {
  id               Int                 @id @default(autoincrement())
  /// 批次类型：体验三日 / 正价月度
  batchType        SettlementBatchType
  /// 时间范围（自然日维度）
  periodStart      DateTime
  periodEnd        DateTime
  /// 创建人（财务/客服主管）
  createdBy        Int
  /// 汇总缓存：用于前端“总收入/俱乐部收入/应结款”展示
  /// 说明：这些值也可以实时聚合计算；缓存是为了查询快
  totalIncome      Float?
  clubIncome       Float?
  payableToPlayers Float?
  createdAt        DateTime            @default(now())
  creator          User                @relation("BatchCreator", fields: [createdBy], references: [id])

  @@index([batchType])
  @@index([periodStart, periodEnd])
  @@index([createdBy], map: "SettlementBatch_createdBy_fkey")
}

model WalletAccount {
  id               Int      @id @default(autoincrement())
  /// 一人一账
  userId           Int      @unique
  /// 可用余额（可提现/可抵扣）
  availableBalance Decimal  @default(0.0) @db.Decimal(10, 1)
  /// 冻结余额（未到解冻时间）
  frozenBalance    Decimal  @default(0.0) @db.Decimal(10, 1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// 钱包UID：展示级唯一号（大写字母+数字混合），兼容老数据先允许为空
  walletUid        String?  @unique @db.VarChar(20)
  depositBalance   Decimal  @default(0.00) @db.Decimal(10, 2)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_accounts")
}

model WalletTransaction {
  id                       Int                      @id @default(autoincrement())
  userId                   Int
  direction                WalletDirection
  bizType                  WalletBizType
  /// 约定：金额始终为正数，负向效果由 direction=OUT 或 bizType 语义决定（实现层做约束）
  amount                   Float
  status                   WalletTxStatus           @default(FROZEN)
  /// 资金来源（用于幂等与追溯）
  /// V0.1：sourceType 固定用 "ORDER_SETTLEMENT"
  sourceType               String
  sourceId                 Int
  /// 方便查账的冗余关联（可空）
  orderId                  Int?
  dispatchId               Int?
  settlementId             Int?
  /// 退款冲正关联：reversalOfTxId 指向被冲正的那笔收益流水
  reversalOfTxId           Int?
  createdAt                DateTime                 @default(now())
  /// ✅ 余额快照：本笔落账后的余额（用于前端展示“本笔后余额”/对账）
  /// - 兼容历史：允许为空；新写入必须赋值
  availableAfter           Decimal?                 @db.Decimal(18, 2)
  frozenAfter              Decimal?                 @db.Decimal(18, 2)
  hold                     WalletHold?              @relation("WalletEarningHold")
  reversalOfTx             WalletTransaction?       @relation("WalletReversal", fields: [reversalOfTxId], references: [id])
  reversals                WalletTransaction[]      @relation("WalletReversal")
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalPayoutRequest  WalletWithdrawalRequest? @relation("WithdrawalPayoutTx")
  withdrawalReserveRequest WalletWithdrawalRequest? @relation("WithdrawalReserveTx")

  @@unique([sourceType, sourceId], map: "uniq_wallet_tx_source")
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([settlementId])
  @@index([status])
  @@index([reversalOfTxId], map: "wallet_transactions_reversalOfTxId_fkey")
  @@map("wallet_transactions")
}

model WalletHold {
  id          Int               @id @default(autoincrement())
  userId      Int
  /// 对应哪一笔收益流水（冻结从这里来）
  earningTxId Int               @unique
  amount      Float
  status      WalletHoldStatus  @default(FROZEN)
  /// 解冻时间（体验单 N+3；非体验 N+15；后续可按等级覆盖）
  unlockAt    DateTime
  createdAt   DateTime          @default(now())
  releasedAt  DateTime?
  earningTx   WalletTransaction @relation("WalletEarningHold", fields: [earningTxId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, unlockAt])
  @@index([userId], map: "wallet_holds_userId_fkey")
  @@map("wallet_holds")
}

model WalletWithdrawalRequest {
  id             Int                @id @default(autoincrement())
  /// 申请人
  userId         Int
  /// 申请金额（始终为正数）
  amount         Float
  status         WithdrawalStatus   @default(PENDING_REVIEW)
  channel        WithdrawalChannel  @default(MANUAL)
  /// ✅ 幂等键：前端/客户端生成（推荐 uuid），用于防重复提交
  /// - 同一个 userId + idempotencyKey 只能申请一次
  idempotencyKey String             @db.VarChar(64)
  /// ✅ 业务单号：服务端生成（可用于展示/对账/三方回调关联）
  requestNo      String             @unique @db.VarChar(32)
  /// 申请备注（可选）
  remark         String?
  /// 审批信息
  reviewedBy     Int?
  reviewedAt     DateTime?
  reviewRemark   String?
  /// ✅ 关键：关联“预扣流水”（申请时产生）
  reserveTxId    Int                @unique
  /// ✅ 关键：关联“出款流水”（打款成功时产生，可空）
  payoutTxId     Int?               @unique
  /// ---------- 为微信自动打款预留 ----------
  /// 外部打款单号（你系统生成，发给微信用）
  outTradeNo     String?            @db.VarChar(64)
  /// 微信/三方返回的交易号
  channelTradeNo String?            @db.VarChar(64)
  /// 三方回调原始内容（可存 JSON 字符串）
  callbackRaw    String?            @db.Text
  /// 最近一次打款错误原因
  failReason     String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  payoutTx       WalletTransaction? @relation("WithdrawalPayoutTx", fields: [payoutTxId], references: [id])
  reserveTx      WalletTransaction  @relation("WithdrawalReserveTx", fields: [reserveTxId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey], map: "uniq_withdraw_user_idempotency")
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, reviewedAt])
  @@map("wallet_withdrawal_requests")
}

model WalletDepositTransaction {
  id         Int            @id @default(autoincrement())
  userId     Int
  amount     Decimal        @db.Decimal(10, 2)
  bizType    DepositBizType
  remark     String?        @db.VarChar(255)
  operatorId Int?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

