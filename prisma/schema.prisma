/// 订单总状态（用于列表筛选与业务流转）
/// 说明：我们把“每次派单”的细节放在 DispatchStatus，OrderStatus 体现订单整体所处阶段
enum OrderStatus {
  WAIT_ASSIGN
  WAIT_ACCEPT
  ACCEPTED
  ARCHIVED
  COMPLETED_PENDING_CONFIRM
  COMPLETED
  WAIT_REVIEW
  REVIEWED
  WAIT_AFTERSALE
  AFTERSALE_DONE
  REFUNDED
}

/// 派单批次状态（每一轮派单都有一个状态；一个订单可多轮派单）
/// 规则：
/// - 只有 ARCHIVED 才允许创建下一轮 dispatch
/// - ACCEPTED 的判定是“本轮所有参与者都接单”
enum DispatchStatus {
  WAIT_ASSIGN
  WAIT_ACCEPT
  ACCEPTED
  /// ✅ 并发互斥用：结算处理中（结单/存单都会先抢占到这个状态）
  /// - 作用：避免“一个点结单、一个点存单”同时跑结算链路
  /// - 约束：只能从 ACCEPTED -> SETTLING；最终落到 ARCHIVED 或 COMPLETED
  SETTLING
  ARCHIVED
  COMPLETED
}

/// 结算打款状态（财务对账后标记）
enum PaymentStatus {
  UNPAID
  PAID
}

/// 批次结算类型
/// - EXPERIENCE_3DAY：体验单/福袋单每 3 个自然日结算
