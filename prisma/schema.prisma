enum WalletBizType {
  /// 兼容历史：旧的“结算收益”
  SETTLEMENT_EARNING
  /// ✅ 基础结算收益（建议新数据都用这个）
  SETTLEMENT_EARNING_BASE
  /// ✅ 补单收益（炸单池补偿）
  SETTLEMENT_EARNING_CARRY
  /// ✅ 炸单损耗（负收益/成本扣减）
  SETTLEMENT_BOMB_LOSS
  /// ✅ 客服分红
  SETTLEMENT_EARNING_CS
  RELEASE_FROZEN
  REFUND_REVERSAL
  /// ✅ 提现：申请时的资金预扣（available -> frozen）
  WITHDRAW_RESERVE
  /// ✅ 提现：审批拒绝/��消时的退回（frozen -> available）
  WITHDRAW_RELEASE
  /// ✅ 提现：实际出款成功（冻结资金真正扣除）
  WITHDRAW_PAYOUT
  /// 新增：押金退还
  DEPOSIT_REFUND
  /// 押金增加（通用，含手动缴纳/规则转押金）
  DEPOSIT_ADD
  /// 押金扣减（通用，含处罚扣减等）
  DEPOSIT_DEDUCT
  /// 线下运营成本缴费
  OFFLINE_FEE_PAYMENT
  SETTLEMENT_REVERSAL
  SETTLEMENT_RECALC
}

