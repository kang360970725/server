{
  "name": "system-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",

    "start:dev": "dotenv -e .env.dev -- nest start --watch",
    "start:prodclone": "dotenv -e .env.prodclone -- nest start --watch",
    "start:debug:dev": "dotenv -e .env.dev -- nest start --debug --watch",
    "start:debug:prodclone": "dotenv -e .env.prodclone -- nest start --debug --watch",
    "start:prod": "node dist/main.js || node dist/src/main.js",

    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",

    "prisma:generate": "prisma generate",
    "prisma:studio:dev": "dotenv -e .env.dev -- prisma studio",
    "prisma:studio:prodclone": "dotenv -e .env.prodclone -- prisma studio",
    "prisma:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev",
    "prisma:seed:dev": "dotenv -e .env.dev -- prisma db seed",
    "prisma:seed:prodclone": "dotenv -e .env.prodclone -- prisma db seed",
    "prisma:push:dev": "dotenv -e .env.dev -- prisma db push",
    "prisma:push:prodclone": "dotenv -e .env.prodclone -- prisma db push",
    "prisma:generate:dev": "dotenv -e .env.dev -- prisma generate",
    "prisma:generate:prodclone": "dotenv -e .env.prodclone -- prisma generate",
    "wallet:repair-snapshots:dry": "ts-node --transpile-only scripts/repair-wallet-snapshots.ts",
    "wallet:repair-snapshots:apply": "ts-node --transpile-only scripts/repair-wallet-snapshots.ts --apply",
    "wallet:repair-snapshots:single:dry": "ts-node --transpile-only scripts/repair-wallet-snapshots.ts --userId=$USER_ID",
    "wallet:repair-snapshots:single:apply": "ts-node --transpile-only scripts/repair-wallet-snapshots.ts --apply --userId=$USER_ID",
    "wallet:repair-snapshots:batch:dry": "ts-node --transpile-only scripts/repair-wallet-snapshots.ts --batchSize=1000 --maxBatches=500",
    "wallet:repair-snapshots:batch:apply": "ts-node --transpile-only scripts/repair-wallet-snapshots.ts --apply --batchSize=1000 --maxBatches=500",
    "wallet:audit-overpay": "ts-node --transpile-only scripts/audit-wallet-overpay.ts",
    "penalty:ensure-tables": "ts-node --transpile-only scripts/ensure-penalty-tables.ts"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.17.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@prisma/client": "^6.18.0",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.2",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^6.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "class-transformer": "^0.5.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
